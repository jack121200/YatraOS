# Copy this file to frontend/.env.local and fill in real values.
# frontend/.env.local is git-ignored — never commit it.
# Vite only exposes vars prefixed VITE_ to the browser — public keys only,
# never the Supabase service role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=
